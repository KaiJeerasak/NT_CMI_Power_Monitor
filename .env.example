# Copy this file to .env.local and enter values on your own machine.
# Restrict the Longdo browser key to the domains that host this app.
NEXT_PUBLIC_LONGDO_MAP_KEY=your_longdo_map_key

# MariaDB read-only account for the station API.
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=iot
DB_USER=your_read_only_user
DB_PASSWORD=your_database_password

# Supabase Auth, account approvals, and shared station configuration.
# Keep the secret key server-side only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Mark a station offline when its source timestamp is older than this many seconds.
STATION_STALE_AFTER_SECONDS=600
